{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QSDB Studio",
  "version": "0.1.0",
  "identifier": "com.qsdb.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "QSDB Studio",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "qinwh",
    "copyright": "Copyright © 2026 qinwh. Source-available under PolyForm Noncommercial 1.0.0.",
    "category": "DeveloperTool",
    "shortDescription": "QSDB Studio — QSDB 桌面客户端",
    "longDescription": "连接、浏览、查询并观测 QSDB 实例：分区与 generation、三闸热更、会话/运行查询、提交事件流、grants 与 COPY/CSV。",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      },
      "wix": {
        "language": "zh-CN"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ]
  }
}
